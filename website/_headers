# Netlify _headers file.
# Applies sensible security headers to every URL served from the site.
# Full docs: https://docs.netlify.com/routing/headers/

/*
  # Tell browsers this site should only ever be loaded over HTTPS,
  # for a year, including subdomains. `preload` makes it eligible for
  # inclusion in the browser-baked HSTS preload list.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Stop other sites from framing this one (clickjacking defence).
  X-Frame-Options: DENY

  # Stop browsers from MIME-sniffing a response away from its declared type.
  X-Content-Type-Options: nosniff

  # Send the origin of referring requests but not the full path / query.
  Referrer-Policy: strict-origin-when-cross-origin

  # Opt out of features we do not and will not use.
  # `interest-cohort=()` opts out of Google Topics/FLoC for the whole site.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # Content Security Policy.
  #   default-src 'self'                            Only same-origin by default.
  #   style-src 'self' 'unsafe-inline' fonts.googleapis.com
  #                                                 Same-origin CSS plus the Google
  #                                                 Fonts stylesheet and the small
  #                                                 number of inline style attributes
  #                                                 used for button margins.
  #   font-src 'self' fonts.gstatic.com             Google Fonts webfont files.
  #   img-src 'self' data:                          Local images + inline SVG data: URIs.
  #   script-src 'self' 'unsafe-inline'             The inline nav-toggle onclick, plus
  #     static.cloudflareinsights.com               the Cloudflare Web Analytics beacon.
  #                                                 The beacon is the only external JS, it is
  #                                                 cookie-free, and it loads only once a token
  #                                                 is set in practice_constants.json.
  #   connect-src 'self' api.web3forms.com          AJAX/fetch to Web3Forms for the contact form,
  #     cloudflareinsights.com                      and where the analytics beacon POSTs its hit.
  #   form-action 'self' api.web3forms.com          Submitting <form> to Web3Forms.
  #   frame-ancestors 'none'                        Not embeddable in iframes.
  #   base-uri 'self'                               Lock down <base href> hijacking.
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; form-action 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; upgrade-insecure-requests

# Cache static assets aggressively; HTML for a short time only (so edits
# appear quickly after a deploy).
/*.css
  Cache-Control: public, max-age=604800
/*.js
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=2592000

# Pages are listed one by one, and deliberately so.
#
# The rule here used to be `/*.html`, which never once applied to a page.
# Cloudflare Pages serves this site at extensionless URLs and 307-redirects
# the .html forms to them, so `/*.html` only ever matched the redirect. Every
# actual page was served with Pages' default `max-age=0, must-revalidate`,
# and the intended five-minute cache had no effect from the day the site
# went up. Verified against production before this was changed:
#
#   /about        public, max-age=0, must-revalidate     <- the page
#   /about.html   public, max-age=300, must-revalidate   <- the redirect
#
# A single `/*` rule placed above the asset rules would also work, but only
# if Cloudflare resolves overlapping rules last-match-wins. Rather than
# depend on that, each page gets its own rule: no rule here overlaps another
# or touches the asset rules above, so the result is the same whatever the
# precedence order turns out to be.
#
# Adding a page means adding a line. tools/verify.py fails if this list and
# build_website.js's PAGES ever disagree, so that cannot be forgotten.
/
  Cache-Control: public, max-age=300, must-revalidate
/about
  Cache-Control: public, max-age=300, must-revalidate
/approach
  Cache-Control: public, max-age=300, must-revalidate
/fees
  Cache-Control: public, max-age=300, must-revalidate
/for-teams
  Cache-Control: public, max-age=300, must-revalidate
/faq
  Cache-Control: public, max-age=300, must-revalidate
/contact
  Cache-Control: public, max-age=300, must-revalidate
/privacy
  Cache-Control: public, max-age=300, must-revalidate
/thank-you
  Cache-Control: public, max-age=300, must-revalidate

# Kept only so the .html redirects are themselves cacheable. It does not,
# and cannot, apply to a page; see above.
/*.html
  Cache-Control: public, max-age=300, must-revalidate
